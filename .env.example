# ---------------------------------------------------------------------------
# i have been leaked — environment variables
#
# Copy to `.env` for local runs (Vite exposes NOTHING from here to the client:
# these are read by the server code in netlify/lib only).
# On Netlify, declare them under Site settings → Environment variables.
# ---------------------------------------------------------------------------

# Optional. Enables the Orelys provider.
# Without it, Orelys is reported "not configured" and lookups are marked
# incomplete — never "clean".
ORELYS_API_KEY=

# Optional. Only needed if your Orelys plan documents a non-standard header.
# Defaults to `Authorization` with a `Bearer ` prefix.
# ORELYS_API_KEY_HEADER=Authorization
# ORELYS_API_KEY_PREFIX=Bearer
